#!/usr/bin/env bash
set -euo pipefail

PIPER_BIN="${PIPER_BIN:-/usr/local/bin/piper}"
MODEL=""
LENGTH_SCALE="${PIPER_LENGTH_SCALE:-0.95}"
SENTENCE_SILENCE="${PIPER_SENTENCE_SILENCE:-0.15}"
OUT_WAV=""
PLAY="yes"

while [ $# -gt 0 ]; do
  case "$1" in
    --length-scale|--length_scale) LENGTH_SCALE="$2"; shift 2 ;;
    --sentence-silence|--sentence_silence) SENTENCE_SILENCE="$2"; shift 2 ;;
    --no-play) PLAY=""; shift ;;
    --output-file|--output_file) OUT_WAV="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) break ;;
  esac
done

TEXT="${*:-}"
if [ -z "$TEXT" ] && [ ! -t 0 ]; then
  TEXT="$(cat)"
fi
[ -n "$TEXT" ] || exit 0

if [ -z "$MODEL" ]; then
  MODEL="${PIPER_MODEL:-}"
fi
if [ -z "$MODEL" ]; then
  MODEL="/opt/piper/voices/ru_RU-irina-medium/ru_RU-irina-medium.onnx"
fi
if [ -z "$OUT_WAV" ]; then
  OUT_WAV="$(mktemp /tmp/piper-tts.XXXXXX.wav)"
  trap 'rm -f "$OUT_WAV"' EXIT
fi

if [ ! -x "$PIPER_BIN" ]; then
  echo "piper binary not executable: $PIPER_BIN" >> /tmp/mdm-piper-tts.log
  exit 1
fi
if [ ! -f "$MODEL" ] || [ ! -f "${MODEL}.json" ]; then
  echo "model files missing: $MODEL" >> /tmp/mdm-piper-tts.log
  exit 1
fi

printf '%s' "$TEXT" | "$PIPER_BIN" \
  --model "$MODEL" \
  --length_scale "$LENGTH_SCALE" \
  --sentence_silence "$SENTENCE_SILENCE" \
  --output_file "$OUT_WAV" >> /tmp/mdm-piper-tts.log 2>&1

if [ -z "$PLAY" ]; then
  exit 0
fi

if command -v paplay >/dev/null 2>&1; then
  VOL_PULSE="${PIPER_VOLUME_PULSE:-52000}"
  paplay --volume="$VOL_PULSE" "$OUT_WAV" >> /tmp/mdm-piper-tts.log 2>&1 && exit 0
fi

if command -v aplay >/dev/null 2>&1; then
  aplay -q "$OUT_WAV" >> /tmp/mdm-piper-tts.log 2>&1 && exit 0
fi

echo "No playback backend succeeded" >> /tmp/mdm-piper-tts.log
exit 1